# TUNIBEAT server configuration. Copy to .env (or set in your process manager) — never commit real secrets.
# Every variable is optional in development; defaults are shown. See server/config.js for the source of truth.
# The server reads process.env directly: load this file with `node --env-file=.env server/index.js`.

# ---- Runtime --------------------------------------------------------------------------------
NODE_ENV=development            # "production" turns off dev tools and sandbox payments, and forces secure cookies
PORT=5173
HOST=127.0.0.1                  # 0.0.0.0 behind a reverse proxy / in a container
PUBLIC_URL=http://localhost:5173 # used in emails (verification, password reset links)
WEB_ROOT=                       # static front end; defaults to the project root (use ./dist for the built bundle)

# ---- Storage --------------------------------------------------------------------------------
DATA_DIR=./server/data          # SQLite database (WAL), public media, caches
PRIVATE_DIR=                    # masters, stems and prepared downloads; default DATA_DIR/private. Never web-served.
MEDIA_BASE_URL=                 # CDN origin for public media in production (empty = served by this server)

# ---- Security -------------------------------------------------------------------------------
COOKIE_SECURE=false             # true whenever the site is served over HTTPS (default true in production)
DEV_TOOLS=true                  # demo sign-in, /api/dev/mail outbox, sandbox payment page. Always off in production.
DOWNLOAD_SECRET=                # REQUIRED in production: 32+ random bytes (hex). Signs 15-minute download links.
                                # If unset, a random secret is generated per process (links break on restart).

# ---- Payments & payouts ---------------------------------------------------------------------
PAYMENTS_PROVIDER=sandbox       # sandbox | stripe | none (default none in production)
SANDBOX_WEBHOOK_SECRET=         # sandbox webhook signing secret (random per process if unset)
STRIPE_SECRET_KEY=              # sk_test_… / sk_live_…  (Stripe adapter is implemented but NOT exercised by tests)
STRIPE_WEBHOOK_SECRET=          # whsec_…
PAYOUTS_PROVIDER=sandbox        # sandbox | none — no real payout rail is integrated yet

# ---- Audio pipeline -------------------------------------------------------------------------
AUDIO_WORKERS=                  # worker threads for decode/analysis/encode (default: min(2, cores-1))
AUDIO_CACHE_MAX_MB=5120         # prepared downloads cache; least-recently-used files are trimmed

# ---- Social / live --------------------------------------------------------------------------
LIVE_TRANSPORT=webrtc-mesh      # WebRTC mesh (small audiences). An SFU is not integrated.
LIVE_MESH_MAX_VIEWERS=20
LIVE_RECONNECT_GRACE_MS=60000
ICE_SERVERS=                    # JSON array of RTCIceServer, e.g. [{"urls":"stun:stun.l.google.com:19302"}]; add TURN for production
STORY_LIFETIME_MS=86400000

# ---- Split hosting: front end on Vercel, this server elsewhere (see README → Deploy) --------
PROXY_SECRET=                   # 24+ random characters; set the SAME value in the Vercel project. The server then
                                # trusts the visitor IP sent by middleware.js (rate limits); without it, it's ignored.
PUBLIC_WS_URL=                  # wss://your-api-host/ws — where browsers open WebSockets (Vercel can't proxy them).
                                # On Render this is derived from RENDER_EXTERNAL_URL automatically.
SEED_DEMO=true                  # false = start with an empty store (read by server/index.js)

# ---- Email (required in production for sign-up verification and password resets) -----------
RESEND_API_KEY=                 # https://resend.com — setting this enables the Resend adapter
MAIL_FROM=                      # e.g. "TUNIBEAT <no-reply@yourdomain.com>" (a domain verified in Resend)

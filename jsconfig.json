{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "server/**/*.js",
    "tests/helpers.js",
    "tests/api/**/*.js"
  ],
  "exclude": [
    "server/seed-data/*-catalog.js"
  ]
}
